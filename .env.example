# Copy to .env and fill in. The app runs fully without this key (deterministic mock mode).
ANTHROPIC_API_KEY=

# Optional overrides.
# Two tiers: the flagship writes the daily brief and meeting prep, the fast tier
# answers questions, writes SQL and drafts email. See ai/prompts/tasks.py.
# INTELLIA_MODEL=claude-opus-5
# INTELLIA_FAST_MODEL=claude-sonnet-5
# INTELLIA_DEBUG=0

# Point the writable store elsewhere. The test suite sets this so a run cannot
# edit the canvas you are looking at.
# INTELLIA_APP_STATE_DB=/tmp/app_state.db
